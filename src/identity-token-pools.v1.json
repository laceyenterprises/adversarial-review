  "families": [
    "codex",
    "claude",
    "gemini",
    "grok"
  ],
  "account_fields": [
    "family",
    "broker_provider",
    "holder_user",
    "allowed_models",
    "concurrency",
    "kind",
    "broker_instance"
  ],
  "required_fields": [
    "family",
    "allowed_models",
    "concurrency"
  ],
  "max_concurrency": 64,
  "max_models": 128,
  "max_pool_accounts": 64,
  "broker_families": {
    "codex": "codex",
    "codex-corp": "codex",
    "claude-code": "claude",
    "claude-code-corp": "claude",
    "grok": "grok",
    "grok-api": "grok"
  },
  "role_families": {
    "codex": "codex",
    "codex-reviewer": "codex",
    "hammer": "codex",
    "remediator-codex": "codex",
    "sre": "codex",
    "sre-responder": "codex",
    "claude-code": "claude",
    "claude-reviewer": "claude",
    "hammer-claude": "claude",
    "remediator-claude": "claude",
    "gemini-reviewer": "gemini",
    "grok": "grok",
    "grok-reviewer": "grok",
    "remediator-grok": "grok",
    "hammer-grok": "grok"
  },
  "instance_fields": [
    "provider",
    "custody_dir",
    "op_ref"
  ],
  "provider_kinds": {
    "grok": "oauth",
    "grok-api": "api-key"
  },
  "max_broker_instances": 64
