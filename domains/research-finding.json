{
  "id": "research-finding",
  "enabled": false,
  "subjectChannel": "markdown-file",
  "commsChannel": "slack-thread",
  "reviewerRuntime": "fixture-stub",
  "agentRuntimeSettleSmokeVerified": false,
  "operatorSurface": {
    "triageSync": "linear"
  },
  "sorGate": {
    "provider": "attestation-log",
    "principal": "research-finding-attestor"
  },
  "promptSet": "research-finding",
  "riskClasses": {
    "low": {
      "maxRemediationRounds": 1
    },
    "medium": {
      "maxRemediationRounds": 3
    },
    "high": {
      "maxRemediationRounds": 3
    },
    "critical": {
      "maxRemediationRounds": 4
    }
  },
  "reviewerRouting": {
    "human": "codex-reviewer-lacey",
    "researcher": "codex-reviewer-lacey"
  },
  "roleRegistry": {
    "remediator": {
      "promptSet": "research-finding",
      "workerClass": "codex",
      "taskKind": "remediation",
      "completionShape": "branch-push"
    },
    "code-quality-reviewer": {
      "promptSet": "research-finding",
      "workerClass": "codex",
      "taskKind": "review",
      "completionShape": "decision-only"
    },
    "security-reviewer": {
      "promptSet": "research-finding",
      "workerClass": "codex",
      "taskKind": "review",
      "completionShape": "decision-only"
    }
  },
  "mergeAuthority": {
    "autonomousMergeExecutionEnabled": true,
    "strictMode": true,
    "strictNonBlockingRemediation": true,
    "workerClass": "hammer",
    "workerClassFallback": ["claude-code"],
    "mergeMethod": "squash",
    "hammerLifetimeDispatchCeiling": 6,
    "lha": {
      "consumeAttestations": true
    },
    "eligibility": {
      "riskClasses": ["low"],
      "fastMergeLabels": ["fast-merge:test-fixtures", "fast-merge:docs"],
      "highRiskRequiresTwoKey": true
    },
    "branchProtection": {
      "required": true
    }
  }
}
