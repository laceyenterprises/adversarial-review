# Local operator overrides for adversarial-review.
# Copy relevant keys into config.local.yaml; this example is not loaded.

# Review additional GitHub orgs. The watcher always lists the org in config.json;
# each login named here is listed too, using that org's owner-scoped client (an
# org without one is skipped with one log line). excludeRepos applies across
# all orgs. Merge enablement stays a separate per-repository decision.
# Deployment prerequisite: first deploy github.additional_orgs schema support in
# the Agent OS Python loader (platform/agent-os-config/) and shell loader
# (modules/worker-pool/lib/agent-os-config-loader.sh). Validate the intended local
# configuration with all three loaders before enabling this key on a host.
# Until then, leave the key absent: even an explicit empty list is an unknown
# key to an older strict loader. See docs/data-model/repository-identities.md.
# github:
#   additional_orgs:
#     - example-second-org

# Repository-specific Git author and committer identity for follow-up
# workspaces and local remediation workers (RDXREMIDENTITY-02). The mapping is
# keyed by lower-cased owner/name, then worker class, to { name, email }, the
# same shape as the env var REMEDIATION_WORKER_GIT_IDENTITY_REPO_OVERRIDES,
# which wins when it is set. Name and email must be non-blank and contain no
# NUL, CR, LF, "<" or ">". A repository or class with no entry falls back to
# REMEDIATION_WORKER_GIT_NAME_<CLASS> / REMEDIATION_WORKER_GIT_EMAIL_<CLASS>,
# then the built-in defaults. A malformed entry warns without printing values
# and falls back the same way; the strict loader rejects a bad field at load.
# Deployment prerequisite: as with github.additional_orgs above, validate the
# key with the Agent OS Python and shell loaders before enabling it on a host,
# because an older strict loader refuses a key it does not know.
# remediation:
#   git_identity_repo_overrides:
#     example-org/example-repo:
#       codex:
#         name: Example Agent
#         email: 12345+example-agent[bot]@users.noreply.github.com

adversarial:
  reviewer:
    load_aware:
      enabled: true
      # Multiplier cap: 1..20 inclusive (default 6).
      max_multiplier: 6

reviewer:
  # Memory-pressure profile examples. Uncomment one profile on each host and
  # tune the numbers after observing local reviewer behavior.
  #
  # Small laptop / 16 GB:
  # memory:
  #   pressure:
  #     projected_headroom_floor_mb: 1536
  #     elevated_available_mb: 3072
  #     critical_available_mb: 1536
  #     elevated_swap_used_pct: 80.0
  #     critical_swap_used_pct: 90.0
  #     swap_pressure_available_mb: 4096
  #
  # Standard laptop / 32-64 GB:
  # memory:
  #   pressure:
  #     projected_headroom_floor_mb: 1024
  #     elevated_available_mb: 2048
  #     critical_available_mb: 1024
  #     elevated_swap_used_pct: 85.0
  #     critical_swap_used_pct: 95.0
  #     swap_pressure_available_mb: 8192
  #
  # Large workstation / 96+ GB:
  # memory:
  #   pressure:
  #     projected_headroom_floor_mb: 2048
  #     elevated_available_mb: 4096
  #     critical_available_mb: 2048
  #     elevated_swap_used_pct: 90.0
  #     critical_swap_used_pct: 98.0
  #     swap_pressure_available_mb: 16384

  gemini:
    # Default is cli. Antigravity mode uses the real agy CLI keychain auth.
    runtime: antigravity
    antigravity:
      print_timeout_ms: 1140000

# MSM hard cutover controls. One-line disable fallback:
# roles.adversarial.merge_authority.autonomous_merge_execution_enabled: false
# Then bounce the adversarial watcher. Disabled mode does not restore the old
# closer; it writes a fail-closed audit and leaves the PR for manual operator
# intervention.
roles:
  adversarial:
    merge_authority:
      autonomous_merge_execution_enabled: true
      # Default on: daemon merges only zero-finding reviews. false permits
      # daemon merge over known non-blocking findings.
      strict_mode: true
