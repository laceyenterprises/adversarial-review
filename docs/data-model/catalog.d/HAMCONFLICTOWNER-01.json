{
  "version": 1,
  "entries": [
    {
      "id": "follow-up-jobs",
      "title": "Follow-Up Remediation Jobs",
      "path": "docs/data-model/follow-up-jobs.md",
      "store": "data/follow-up-jobs/{pending,in-progress,completed,failed,stopped,single-review-voids,missing-label-events}/*.json",
      "schemaSurface": "src/follow-up-jobs.mjs",
      "relatedSchemaSurfaces": [
        "src/follow-up-branch.mjs",
        "src/remediation-unpublished.mjs",
        "src/worker-token-pool.mjs",
        "src/follow-up-remediation.mjs",
        "src/follow-up-retrigger-review-label.mjs",
        "src/remediation-conflicted-base.mjs",
        "src/comment-only-final-round.mjs",
        "src/follow-up-job-write.mjs",
        "src/pollonce-phases.mjs",
        "src/comment-only-final-round-completion.mjs",
        "src/follow-up-review-claim.mjs",
        "src/ama-closure-orchestration.mjs",
        "src/remediation-quota-hold.mjs",
        "src/remediation-claimed-requeue.mjs",
        "src/remediation-worker-class-fallback.mjs",
        "src/gemini-remediated-head.mjs",
        "src/remediation-published-head.mjs",
        "src/remediation-closeout.mjs",
        "src/remediation-job-ownership.mjs",
        "src/reviewer-ci-admission.mjs",
        "src/adapters/comms/github-pr-comments/comment-delivery.mjs",
        "src/remediation-round-accounting.mjs",
        "src/remediation-infrastructure-refund.mjs",
        "src/remediation-quota-evidence.mjs",
        "src/review-mode-selection.mjs",
        "src/github-auth-recovery.mjs",
        "src/remediation-ci-infrastructure.mjs",
        "src/ama/conflict-primary-handoff.mjs",
        "src/ama/hammer-stop-hold.mjs",
        "src/pr-next-action.mjs",
        "src/remediation-prompt-builder.mjs",
        "src/ama/final-fix-all.mjs"
      ],
      "owner": "follow-up remediation queue",
      "conflictPrimaryHandoff": {
        "optionalField": "closureHandoff",
        "fields": [
          "reason",
          "headSha",
          "review",
          "reviewContext"
        ],
        "reason": "conflict-primary-unproven",
        "triggerType": "closer-terminal-audit",
        "review": "full",
        "reviewContextFields": [
          "body",
          "url"
        ],
        "reviewContextLimits": {
          "maxEntries": 50,
          "maxBodyChars": 2000,
          "maxUrlChars": 2048,
          "selection": "most recent update/submission/creation time; undated entries first in source order"
        },
        "identity": [
          "repo",
          "prNumber",
          "revisionRef",
          "jobId"
        ],
        "deduplication": "existing cross-process review claim keyed by PR/head/reason across every queue status and archived stops",
        "pendingOwner": "remediate/remediator, normal admission deadline; no closer replay",
        "closeout": "fullReviewRequired retains normal review intent at the final allowed push; no suppressed finalPush shortcut"
      },
      "finalFixAllHandoff": {
        "optionalField": "closureHandoff",
        "reason": "final-fix-all",
        "triggerType": "final-round-review",
        "review": "full",
        "maxRounds": 1,
        "deduplication": "repo/pr/source head/reason across active, terminal and archived receipts; publication head falls back after re-review"
      }
    }
  ]
}
