{
  "version": 1,
  "entries": [
    {
      "id": "reviewer-generated-reviews",
      "title": "Reviewer Generated Reviews",
      "path": "docs/data-model/reviewer-generated-reviews.md",
      "store": "data/reviewer-generated-reviews/<repo-slug>-<prNumber>-<headSha>-<passKind>-<reviewerModel>-<originSessionUuid>.json",
      "schemaSurface": "src/reviewer-generated-review-delivery.mjs",
      "relatedSchemaSurfaces": ["src/reviewer.mjs", "src/reviewer-process-deadline.mjs"],
      "owner": "hosted reviewer delivery (REVPOSTSTALL-01)",
      "bodyDigestFields": ["rawReviewSha256", "reviewTextSha256"],
      "deliveryStateValues": ["pending-delivery", "deferred", "write-started", "delivered"],
      "compatibility": "The diffOnly boolean is part of the exact-match reuse key. Older records without the field remain evidence and are ineligible for redelivery."
    }
  ]
}
