{
  "id": "code-pr",
  "enabled": true,
  "subjectChannel": "github-pr",
  "commsChannel": "github-pr-comments",
  "reviewerRuntime": "agent-runtime",
  "agentRuntimeSettleSmokeVerified": true,
  "operatorSurface": {
    "controls": "github-pr-label-controls",
    "triageSync": "linear"
  },
  "sorGate": {
    "provider": "github-commit-status"
  },
  "promptSet": "code-pr",
  "v1GrowthRatchet": {
    "note": "V1RATCHET-01: audited, not gated. Reviewers report net non-test lines per V1 subsystem and ask a fix that grows a pack-owned one for the matching deletion. First matching subsystem wins; paths and owners are tunables.",
    "subsystems": [
      { "id": "merge-authority-v1", "repo": "laceyenterprises/adversarial-review", "pack": "MLR", "paths": ["src/ama/", "src/follow-up-", "src/pollonce-phases.mjs"] },
      { "id": "cwp-dispatch", "repo": "laceyenterprises/agent-os", "pack": "LDP", "paths": ["modules/worker-pool/lib/python/cwp_dispatch/"] },
      { "id": "ojo-scheduling", "repo": "laceyenterprises/agent-os", "pack": "LDP", "paths": ["platform/os-job-orchestrator/"] },
      { "id": "worker-pool", "repo": "laceyenterprises/agent-os", "pack": null, "paths": ["modules/worker-pool/"] },
      { "id": "credential-brokers", "repo": "laceyenterprises/agent-os", "pack": null, "paths": ["modules/model-routing-budget-control/runtime/oauth-provider/", "platform/mcp-auth-broker/"] }
    ]
  },
  "remediationCloneReferences": {
    "laceyenterprises/agent-os": "/Users/airlock/agent-os-hq/worker-base/agent-os",
    "laceyenterprises/adversarial-review": "/Users/airlock/agent-os-hq/adversarial-review/clone-references/adversarial-review.git",
    "laceyenterprises/foundry": "/Users/airlock/agent-os/.git/modules/tools/foundry",
    "laceyenterprises/podium": "/Users/airlock/agent-os/.git/modules/tools/podium"
  },
  "riskClasses": {
    "low": {
      "maxRemediationRounds": 1
    },
    "medium": {
      "maxRemediationRounds": 2
    },
    "high": {
      "maxRemediationRounds": 2
    },
    "critical": {
      "maxRemediationRounds": 2
    }
  },
  "reviewerRouting": {
    "codex": "claude-reviewer-lacey",
    "claude-code": "codex-reviewer-lacey",
    "clio-agent": "claude-reviewer-lacey"
  },
  "roleRegistry": {
    "remediator": {
      "promptSet": "code-pr",
      "workerClass": "codex",
      "taskKind": "remediation",
      "completionShape": "branch-push"
    },
    "code-quality-reviewer": {
      "promptSet": "code-pr",
      "workerClass": "codex",
      "taskKind": "review",
      "completionShape": "decision-only"
    },
    "security-reviewer": {
      "promptSet": "code-pr-security",
      "workerClass": "codex",
      "taskKind": "review",
      "completionShape": "decision-only"
    }
  },
  "mergeAuthority": {
    "autonomousMergeExecutionEnabled": true,
    "strictMode": true,
    "strictNonBlockingRemediation": true,
    "workerClass": "hammer",
    "workerClassFallback": ["hammer-claude"],
    "mergeMethod": "squash",
    "hammerLifetimeDispatchCeiling": 6,
    "amaCloserConcurrentLaunchCeiling": 32,
    "closureLagSloMs": 1800000,
    "lha": {
      "consumeAttestations": true
    },
    "eligibility": {
      "riskClasses": ["low"],
      "fastMergeLabels": ["fast-merge:test-fixtures", "fast-merge:docs"],
      "highRiskRequiresTwoKey": true
    },
    "branchProtection": {
      "required": true
    }
  },
  "pipeline": {
    "enabled": false,
    "stages": [
      {
        "id": "code-quality",
        "panel": ["code-quality-reviewer"],
        "aggregation": { "kind": "unanimous-clean" }
      },
      {
        "id": "security",
        "panel": ["security-reviewer"],
        "aggregation": { "kind": "unanimous-clean" }
      }
    ]
  }
}
